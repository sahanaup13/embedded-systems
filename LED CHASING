from machine import Pin
import time

led1 = Pin(1, Pin.OUT)
led2 = Pin(2, Pin.OUT)
led3 = Pin(3, Pin.OUT)
led4 = Pin(4, Pin.OUT)
led5 = Pin(5, Pin.OUT)
led6 = Pin(6, Pin.OUT)
led7 = Pin(7, Pin.OUT)
led8 = Pin(8, Pin.OUT)

while True:
    led1.high()
    time.sleep(0.1)
    led1.low()

    led2.high()
    time.sleep(0.1)
    led2.low()

    led3.high()
    time.sleep(0.1)
    led3.low()

    led4.high()
    time.sleep(0.1)
    led4.low()

    led5.high()
    time.sleep(0.1)
    led5.low()

    led6.high()
    time.sleep(0.1)
    led6.low()

    led7.high()
    time.sleep(0.1)
    led7.low()

    led8.high()
    time.sleep(0.1)
    led8.low()
