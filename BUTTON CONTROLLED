from machine import Pin
import time


led = Pin(2,Pin.OUT)
button = Pin(0,Pin.IN,Pin.PULL_DOWN)

while True:
    if button.value() == 1:
        led.value(1)
        print("Button is pressed LED is ON")
        time.sleep(0.5)
    else:
        led.value(0)
        print("Button is not pressed LED is OFF")
        time.sleep(0.5)
